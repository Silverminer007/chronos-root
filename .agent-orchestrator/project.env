# Projektkonfiguration von chronos-root für die Pod-Plattform des Agent Orchestrators (github.com/Silverminer007/agent-orchestrator, deployment/k8s/).
# Schlüssel und Bedeutung: deployment/k8s/project/project.example.env dort. Hier steht nur, was dieses Projekt von der Plattform unterscheidet.

PROJECT=chronos
REPO=Silverminer007/chronos-root
REPO_BRANCH=main
GIT_HOST=github.com
FORGE=github

NS_AGENTS=chronos-agents
NS_NIGHTLY=chronos-nightly
NS_BUILD=build
NS_PREVIEW=
REGISTRY=registry.build.svc:5000
IMAGE_NAME=chronos-agent
NODE_LABEL=agent-orchestrator.dev/registry=ready
ZONE_LABEL=
ZONE_PREFERRED=

LABEL_READY=ready-for-agent
LABEL_NEEDS_INPUT=needs-input
LABEL_NEEDS_PO=needs-po
LABEL_BLOCKED=blocked
LABEL_FOLLOWUP=follow-up
LABEL_EPIC=epic
AREA_LABELS="area:rust area:java area:frontend area:deployment area:docs"
AREA_DB=area:rust                     # Rust-Backend-Tests brauchen Postgres (TEST_DATABASE_URL vom Sidecar)
TICKET_FIRST=299                      # ältere Tickets liefen über agentflow; der Steward nimmt nur neue ab

SEC_RE='Sicherheit|Security|Keycloak|Auth|Token|Rolle|Berechtigung|Datenschutz'
CRED_RE='Zugangsdaten|credential|secret|Passwort|Schlüssel|Kosten|Cluster-Zugang'
DB_CMD_RE='cargo test|sqlx|psql|postgres|TEST_DATABASE_URL'
DOCKER_CMD_RE='docker|testcontainers|quarkus:dev|mvnw (test|verify)|kind |helm install'

KB_DIR=kb
STATUS_DIR=kb/status
RULES_FILE=CLAUDE.md
STEWARD_DOC=kb/status/steward.md
INBOX=${HOME}/orchestrator_communication/chronos

NIGHTLY_CMD=".agent-orchestrator/nightly.sh"
NIGHTLY_JOBS="rust frontend java"
DB_TEST_ENV=TEST_DATABASE_URL         # der Sidecar setzt direkt die Variable der Rust-Tests
SIDECARS="postgres"
PG_IMAGE=postgres:16.10               # wie der Dienst in .github/workflows/backend-rust-test.yml (postgres:16)

IMAGES="agent:.agent-orchestrator/image/Dockerfile:."
BASE_IMAGE=registry.build.svc:5000/agent-base:1d77c90fdfe2

LITELLM_TAGS="project-chronos,chronos"

# --- Optionale Schlüssel ------------------------------------------------------------------------------------------------------------
SAFE_PATHS_RE='^(kb/|docs/|.*\.md$)'
UNSAFE_PATHS_RE='migrations|deployment/|\.github/'
AREA_PATHS="area:rust=rust-backend/ area:java=backend/ area:frontend=frontend/ area:deployment=deployment/ area:docs=kb/"
NIGHTLY_MERGE_RE='^(Resolve #[0-9]+|Merge pull request)'
NIGHTLY_REQUIRE_DOCKER_JOBS=0
COMMIT_TRAILER='Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>'
